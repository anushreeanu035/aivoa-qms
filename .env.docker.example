# ==============================================================================
# AIVOA QMS - Docker Deployment Environment Variables
# Copy this file to .env before running: docker compose up -d
# ==============================================================================

# Groq LLM API Key (Obtain from https://console.groq.com/keys)
# If omitted or blank, AIVOA automatically runs in Demo Mode (Mock AI)
GROQ_API_KEY=

# Supported models: llama-3.3-70b-versatile, llama-3.1-70b-versatile, llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# Application Port
PORT=8000

# SQLite Database URL (stored inside persistent volume)
DATABASE_URL=sqlite:////app/data/deviations.db

# If using PostgreSQL with docker-compose.postgres.yml:
# DATABASE_URL=postgresql://aivoa_user:aivoa_secure_password@postgres:5432/aivoi_deviations

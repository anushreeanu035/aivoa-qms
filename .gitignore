# ==============================================================================
# Git Ignore - AIVOA Pharmaceutical QMS
# STRICTLY LOCAL - DO NOT PUSH TO GITHUB OR ANY REMOTE REPOSITORY
# ==============================================================================

# Environment files & Secrets
.env
.env.*
!.env.example
!.env.docker.example
backend/.env
frontend/.env.local

# Python Virtual Environments & Dependencies
backend/venv/
venv/
.venv/
env/
ENV/
*.py[cod]
*$py.class
__pycache__/
**/__pycache__/

# Node.js Dependencies & Builds
node_modules/
frontend/node_modules/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Databases & Runtime Data
*.db
*.sqlite
*.sqlite3
deviations.db
backend/deviations.db
data/
backend/data/

# IDE & OS Specific
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Logs & Testing
*.log
.pytest_cache/
.coverage
htmlcov/

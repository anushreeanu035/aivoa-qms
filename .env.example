# ==========================================
# AIVOA QMS Deviation Intake - Configuration
# ==========================================

# Groq API Configuration
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model (Currently supported and reliable model)
# Examples: llama-3.3-70b-versatile, llama-3.1-70b-versatile, llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# Database Configuration
# PostgreSQL example: postgresql://username:password@localhost:5432/aivoi_deviations
# Default SQLite fallback (no setup required): sqlite:///./deviations.db
DATABASE_URL=sqlite:///./deviations.db

# Server Configuration
PORT=8000
ENVIRONMENT=development
